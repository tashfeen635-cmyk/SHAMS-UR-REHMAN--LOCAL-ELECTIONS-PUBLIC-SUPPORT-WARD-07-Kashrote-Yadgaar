[Unit]
Description=Shams Support Survey
After=network.target

[Service]
Type=simple
User=shams
Group=shams
WorkingDirectory=/opt/shams-survey
EnvironmentFile=/etc/shams-survey/env
ExecStart=/usr/bin/node /opt/shams-survey/server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/var/lib/shams-survey

[Install]
WantedBy=multi-user.target
